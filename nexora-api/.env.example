# NVIDIA hosted Nemotron OCR v2. Keep this key on the API server only.
NVIDIA_API_KEY=
# Optional override; defaults to NVIDIA's hosted Nemotron OCR v2 endpoint.
# NVIDIA_OCR_ENDPOINT=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2

# Gemini model rotation. Keys stay server-side; these IDs are stable API models.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# GEMINI_BACKUP_MODEL=gemini-3.1-flash-lite
