# NVIDIA hosted Nemotron OCR v2. Keep this key on the API server only.
NVIDIA_API_KEY=
# Optional override; defaults to NVIDIA's hosted Nemotron OCR v2 endpoint.
# NVIDIA_OCR_ENDPOINT=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2

# Gemini model rotation. Keys stay server-side; these IDs are stable API models.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# GEMINI_BACKUP_MODEL=gemini-3.1-flash-lite

# Durable session-scoped semantic search (Vercel KV / Upstash REST).
# Vercel injects these when the KV database is connected to this project.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Or use the Upstash aliases:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Clerk authentication. Keep the secret key on the API server only.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional comma-separated allowed browser origins, for example:
# CLERK_AUTHORIZED_PARTIES=https://nexora-dist-seven.vercel.app
